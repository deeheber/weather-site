{
  "name": "weather-site",
  "version": "0.1.0",
  "bin": {
    "weather-site": "bin/weather-site.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "cdk deploy --all",
    "deploy:ci": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all",
    "diff": "cdk diff",
    "format": "oxfmt .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware --quiet",
    "synth": "cdk synth",
    "synth:quiet": "cdk synth -q",
    "test": "vitest run",
    "watch": "tsc -w --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
