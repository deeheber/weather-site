{
  "name": "weather-site",
  "version": "0.1.0",
  "bin": {
    "weather-site": "bin/weather-site.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "cdk": "cdk",
    "deploy": "npm run cdk deploy -- --all",
    "deploy:ci": "npm run cdk deploy -- --all --require-approval never",
    "destroy": "npm run cdk destroy -- --all",
    "diff": "npm run cdk diff -- --all",
    "format": "oxfmt .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware --quiet",
    "synth": "npm run cdk synth",
    "synth:quiet": "npm run cdk synth -- -q",
    "test": "vitest run",
    "watch": "tsc -w --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  }
}
